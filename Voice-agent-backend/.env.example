# Copy to .env next to docker-compose.yaml and fill in.
#
# These are operator settings for running the stack. LLM/ASR/TTS provider
# keys (Google, Sarvam, OpenAI, ...) are NOT set here -- each user adds
# their own in the web UI's Settings page, and calls fail with an
# "add a key in Settings" error until they do.

# --- Required ---------------------------------------------------------------

# Postgres connection string for the orchestrator (agents, users, call history).
DATABASE_URL=postgresql://user:password@host:5432/voice_agent

# Firebase Admin service-account key, as a single-line JSON string. Used to
# verify the Google Sign-In session cookie.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Hugging Face token for downloading models. SraVaani-1.0 and DhVaani-0.5
# are gated -- request access on their model pages with this account first.
HF_TOKEN=

# Shared secret between the orchestrator and the internal `sravaani` ASR
# service. Any random string; both services read the same value.
SRAVAANI_API_BASE=http://sravaani:8002
SRAVAANI_API_KEY=

# --- Optional ---------------------------------------------------------------

# Comma-separated frontend origins allowed to call the API with cookies.
# Defaults to the local Vite dev server origins.
CORS_ORIGINS=

# Require a Firebase App Check (reCAPTCHA v3) token on login. Only enable
# once the frontend is built with VITE_RECAPTCHA_SITE_KEY.
APP_CHECK_ENFORCE=false

# DhVaani TTS on a separate host (see Orchestrator/dhvaani_service.py).
DHVAANI_API_BASE=
DHVAANI_API_KEY=

# Self-hosted Ollama behind a reverse proxy (see Orchestrator/LLM/ollama.py).
OLLAMA_API_BASE=
OLLAMA_API_KEY=

# data.gov.in key for the get_mandi_prices MCP tool (free, from data.gov.in).
# The tool reports itself unavailable when this is empty.
DATA_GOV_IN_API_KEY=
