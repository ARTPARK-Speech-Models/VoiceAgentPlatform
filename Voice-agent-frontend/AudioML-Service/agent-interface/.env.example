# Backend orchestrator base URL. Must be an absolute http(s) URL (see
# src/url.js for why), not a bare "/".
# Local dev (docker-compose orchestrator on this machine): http://localhost:8000/
# Production: your deployment's public URL, e.g. https://voice.example.com/
VITE_API_BASE_URL=

# Firebase web config -- from the Firebase console: Project Settings >
# General > "Your apps" > the registered web app. None of these are
# secret; they're safe to ship in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA v3 site key -- from the Firebase console: Build >
# App Check > register this web app with the reCAPTCHA v3 provider.
VITE_RECAPTCHA_SITE_KEY=
